
//GLOBAL VARIABLES
char* input_file_path;
char* output_file_path;
char* input_flag;

char* input_text_buffer;

char** token_list;
int token_num;

char*** instruction_list;
int* instruction_len_list;
int instruction_num;

//UTILITY FUNCTIONS
insert_instructions(start_index, p_instruction_list);
delete_instructions(start_index, end_index);

insert_tokens(start_index, p_token_list);
delete_tokens(start_index, end_index);

//MAIN
main(int argc, char** argc)
{
    user_input(argc, argv, &input_file_path, &output_file_path, &input_flag);

    input_file_manipulation(input_file_path, &input_text_buffer);

    tokenizer(input_text_buffer, &token_list, &token_num);

    lexer(token_list, token_num, &instruction_list, &instruction_len_list, &instruction_num);

    parser(&instruction_list, &instruction_len_list, &instruction_num);

    generator(&instruction_list, &instruction_len_list, &instruction_num);

    output_file_manipulation(output_file_path, input_flag);
}

//PARSER
parser(char**** p_instruction_list, int** p_instruction_len_list, int* p_instruction_num)
{
    comment_parser();

    stack_parser();

    heap_parser();

    include_parser();

    macrodef_parser();

    macro_parser();

    define_parser();

    label_parser();

    variable_parser();

    base_parser();

    operation_parser();
}

